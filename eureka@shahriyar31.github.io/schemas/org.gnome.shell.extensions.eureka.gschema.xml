<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="eureka">
  <enum id="org.gnome.shell.extensions.eureka.theme-mode">
    <value nick="auto" value="0"/><value nick="light" value="1"/><value nick="dark" value="2"/>
  </enum>
  <enum id="org.gnome.shell.extensions.eureka.accent-source">
    <value nick="system" value="0"/><value nick="custom" value="1"/>
  </enum>
  <enum id="org.gnome.shell.extensions.eureka.density">
    <value nick="comfortable" value="0"/><value nick="compact" value="1"/>
  </enum>
  <enum id="org.gnome.shell.extensions.eureka.monitor">
    <value nick="pointer" value="0"/><value nick="primary" value="1"/>
  </enum>
  <enum id="org.gnome.shell.extensions.eureka.icon-style">
    <value nick="tonal" value="0"/><value nick="plain" value="1"/>
  </enum>

  <schema id="org.gnome.shell.extensions.eureka" path="/org/gnome/shell/extensions/eureka/">
    <!-- behaviour -->
    <key name="toggle" type="as">
      <default><![CDATA[['<Super>space']]]></default>
      <summary>Shortcut that opens Eureka</summary>
    </key>
    <key name="show-apps" type="b"><default>true</default><summary>Search applications</summary></key>
    <key name="show-windows" type="b"><default>true</default><summary>Search open windows</summary></key>
    <key name="show-files" type="b"><default>true</default><summary>Search files with the GNOME file index</summary></key>
    <key name="show-calculator" type="b"><default>true</default><summary>Calculate maths expressions</summary></key>
    <key name="show-system" type="b"><default>true</default><summary>Offer system actions</summary></key>
    <key name="show-web" type="b"><default>true</default><summary>Offer a web search</summary></key>
    <key name="show-providers" type="b"><default>true</default><summary>Results from GNOME search providers (Settings → Search)</summary></key>
    <key name="show-converter" type="b"><default>true</default><summary>Convert units (10 km to mi)</summary></key>
    <key name="show-currency" type="b"><default>false</default><summary>Convert currencies with the ECB's daily rates (downloads the public rates file, never the query)</summary></key>
    <key name="show-suggestions" type="b"><default>true</default><summary>Suggest frequently used apps before typing</summary></key>
    <key name="show-panel-icon" type="b"><default>false</default><summary>Show a search icon in the top bar</summary></key>
    <key name="apps-limit" type="i"><range min="1" max="10"/><default>5</default><summary>Applications shown</summary></key>
    <key name="files-limit" type="i"><range min="1" max="10"/><default>5</default><summary>Files shown</summary></key>
    <key name="max-results" type="i"><range min="4" max="16"/><default>10</default><summary>Maximum number of rows</summary></key>
    <key name="web-engines" type="as">
      <default>['g|Google|https://www.google.com/search?q=%s', 'd|DuckDuckGo|https://duckduckgo.com/?q=%s', 'yt|YouTube|https://www.youtube.com/results?search_query=%s', 'w|Wikipedia|https://en.wikipedia.org/w/index.php?search=%s', 'gh|GitHub|https://github.com/search?q=%s']</default>
      <summary>Web search engines as prefix|name|https-url-with-%s</summary>
    </key>
    <key name="default-engine" type="s"><default>'d'</default><summary>Prefix of the engine used for the fallback web search</summary></key>
    <key name="open-on" enum="org.gnome.shell.extensions.eureka.monitor"><default>'pointer'</default><summary>Monitor to open on</summary></key>

    <!-- appearance -->
    <key name="theme-mode" enum="org.gnome.shell.extensions.eureka.theme-mode"><default>'auto'</default><summary>Light, dark or follow the system</summary></key>
    <key name="accent-source" enum="org.gnome.shell.extensions.eureka.accent-source"><default>'system'</default><summary>Accent colour source</summary></key>
    <key name="custom-accent" type="s"><default>'#6750a4'</default><summary>Custom accent colour (hex)</summary></key>
    <key name="corner-radius" type="i"><range min="0" max="40"/><default>28</default><summary>Corner radius of the panel</summary></key>
    <key name="panel-width" type="i"><range min="480" max="1000"/><default>680</default><summary>Panel width in pixels</summary></key>
    <key name="vertical-position" type="i"><range min="5" max="45"/><default>20</default><summary>Distance from the top, in percent of the screen height</summary></key>
    <key name="opacity" type="i"><range min="60" max="100"/><default>96</default><summary>Panel opacity in percent</summary></key>
    <key name="backdrop-dim" type="i"><range min="0" max="60"/><default>18</default><summary>How much the screen behind is dimmed, in percent</summary></key>
    <key name="density" enum="org.gnome.shell.extensions.eureka.density"><default>'comfortable'</default><summary>Row spacing</summary></key>
    <key name="icon-style" enum="org.gnome.shell.extensions.eureka.icon-style"><default>'tonal'</default><summary>Icons in tinted circles or plain</summary></key>
    <key name="font-family" type="s"><default>''</default><summary>Font family; empty uses the system font</summary></key>
    <key name="font-scale" type="d"><range min="0.8" max="1.4"/><default>1.0</default><summary>Text size multiplier</summary></key>
    <key name="show-sections" type="b"><default>true</default><summary>Show section headings</summary></key>
    <key name="show-subtitles" type="b"><default>true</default><summary>Show the second line under each result</summary></key>
    <key name="show-hints" type="b"><default>true</default><summary>Show keyboard hints</summary></key>
    <key name="animations" type="b"><default>true</default><summary>Animate opening and closing</summary></key>
    <key name="animation-speed" type="d"><range min="0.5" max="2.0"/><default>1.0</default><summary>Animation speed multiplier (higher is faster)</summary></key>
    <key name="blur" type="b"><default>false</default><summary>Blur what is behind the panel</summary></key>
    <key name="blur-radius" type="i"><range min="5" max="100"/><default>40</default><summary>Blur strength</summary></key>
    <key name="show-outline" type="b"><default>true</default><summary>Thin outline around the panel</summary></key>
  </schema>
</schemalist>
